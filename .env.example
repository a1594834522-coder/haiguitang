# OpenAI 兼容协议，默认使用 DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 思考强度 low / high / max
LLM_REASONING_EFFORT=high

# 并发与容量
LLM_MAX_CONCURRENT=16
LLM_QUEUE_TIMEOUT_MS=20000
RATE_PER_IP_PER_MIN=30

PORT=8787
# 部署在 Nginx / CDN 后面时设为 1，从 X-Forwarded-For 读取真实 IP
TRUST_PROXY=0

# 会话落盘位置（留空则只放内存，重启丢局）
SESSION_FILE=data/sessions.json
